# Required browser-safe configuration
REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_ANON_KEY=
REACT_APP_GOOGLE_MAPS_API_KEY=

# Optional staff support link shown on sign in
REACT_APP_SUPPORT_EMAIL=

# Optional service-area overrides (defaults to enforced Southern Ontario)
REACT_APP_SERVICE_AREA_NAME=Southern Ontario
REACT_APP_SERVICE_AREA_VERSION=southern-ontario-v1
REACT_APP_SERVICE_AREA_MODE=enforced
